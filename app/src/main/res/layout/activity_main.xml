<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="@color/white">
<!--    <ImageView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:src="@drawable/appbg"-->
<!--        android:scaleType="fitXY"-->
<!--        ></ImageView>-->
<!--    <View-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:background="@color/black"-->
<!--        android:alpha="0.7"-->
<!--        ></View>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/header"></include>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_31sdp"
            android:layout_margin="@dimen/_10sdp"
            >

            <EditText
                android:id="@+id/et_search"
                android:textSize="@dimen/_11ssp"
                android:layout_width="match_parent"
                android:fontFamily="@font/roboto_light"
                android:layout_height="match_parent"
                android:background="@drawable/roundcorner_stroke"
                android:drawableLeft="@drawable/ic_baseline_search_24"
                android:drawableTint="@color/gray"
                android:paddingRight="@dimen/_15sdp"
                android:maxLines="1"
                android:drawablePadding="@dimen/_15sdp"
                android:paddingLeft="@dimen/_15sdp"
                android:hint="Search Disease/treatment"
                />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/adss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_gravity="center"
            android:gravity="bottom"
            android:orientation="vertical">

            <!--/*banner */ -->


            <com.google.android.gms.ads.AdView
                android:id="@+id/admob_adview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:adSize="BANNER"
                app:adUnitId="@string/banner_ad_unit_id" />
        </LinearLayout>
        <RelativeLayout
            android:layout_width="90dp"
            android:id="@+id/btn_poetry"
            android:visibility="gone"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/roundcorner"
            android:layout_margin="@dimen/_10sdp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Poetry"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:textStyle="bold"
                android:textSize="@dimen/_15sdp"
                android:textColor="@color/white">

            </TextView>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_questions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/date"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_40sdp"></androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>


<View
    android:layout_width="match_parent"
    android:layout_height="@dimen/_1sdp"
    android:background="@color/white"
    android:layout_above="@+id/footer">

</View>
<LinearLayout
    android:id="@+id/footer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_40sdp"
    android:weightSum="3"
    android:orientation="horizontal"
    android:layout_alignParentBottom="true"
    >
    <TextView
        android:id="@+id/btn_rateus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/btnbg"
        android:text="RATE US"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        android:gravity="center"
        />
<View
    android:layout_width="@dimen/_1sdp"
    android:layout_height="@dimen/_15sdp">
</View>
    <TextView
        android:id="@+id/btn_moreapps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/btnbg"
        android:text="Contact Us"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        android:gravity="center"
        />
    <View
        android:layout_width="@dimen/_1sdp"
        android:layout_height="@dimen/_15sdp">
    </View>
    <TextView
        android:id="@+id/btn_shareapp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/btnbg"
        android:text="SHARE"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        android:gravity="center"
        />
</LinearLayout>
</RelativeLayout>